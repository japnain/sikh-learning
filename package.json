{
  "name": "sikh-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run qa:startup-bundle && node ./scripts/copy-public.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "ios:build:release": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "native:generate-catalog": "node ./scripts/native/generate-native-catalog.mjs",
    "native:build": "npm run native:generate-catalog && xcodebuild -project ios/App/App.xcodeproj -scheme NaamRasNative -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "native:test": "npm run native:generate-catalog && xcodebuild test -project ios/App/App.xcodeproj -scheme NaamRasNative -destination 'platform=iOS Simulator,name=iPhone 17' CODE_SIGNING_ALLOWED=NO",
    "lint": "eslint .",
    "qa:a11y": "node ./scripts/qa/accessibility-sweep.mjs",
    "qa:startup-bundle": "node ./scripts/qa/startup-bundle-audit.mjs",
    "qa:css-selectors": "node ./scripts/qa/css-selector-audit.mjs",
    "qa:app-store": "npm run ios:build:release && node ./scripts/qa/app-store-readiness.mjs",
    "library:import": "node ./scripts/library/import-curated-epub.mjs",
    "library:build": "node ./scripts/library/import-panth-prakash-epubs.mjs --vol1-epub ./public/data/library/works/panth-prakash-english/assets/volume-1.epub --vol2-epub ./public/data/library/works/panth-prakash-english/assets/volume-2.epub",
    "library:verify": "node ./scripts/library/verify-library.mjs",
    "preview": "vite preview",
    "test": "node ./scripts/test-vitest-batches.mjs",
    "test:coverage": "vitest run --coverage",
    "qa:ai-bug-sweep": "node ./scripts/qa/ai-bug-sweep.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@nuintun/qrcode": "^4.1.12",
    "@radix-ui/react-dialog": "^1.1.19",
    "@supabase/supabase-js": "^2.105.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "playwright-core": "^1.59.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
