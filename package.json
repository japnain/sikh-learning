{
  "name": "sikh-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ./scripts/learn/copy-build-assets.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "native:generate-catalog": "node ./scripts/native/generate-native-catalog.mjs",
    "native:build": "npm run native:generate-catalog && xcodebuild -project ios/App/App.xcodeproj -scheme NaamRasNative -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "native:test": "npm run native:generate-catalog && xcodebuild test -project ios/App/App.xcodeproj -scheme NaamRasNative -destination 'platform=iOS Simulator,name=iPhone 17' CODE_SIGNING_ALLOWED=NO",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa:ai-bug-sweep": "node ./scripts/qa/ai-bug-sweep.mjs",
    "learn:sync-sggs-corpus": "node ./scripts/learn/sync-sggs-corpus.mjs",
    "learn:generate-drafts": "node ./scripts/learn/generate-drafts.mjs",
    "learn:validate": "node ./scripts/learn/validate.mjs",
    "learn:publish": "node ./scripts/learn/publish.mjs",
    "learn:audit": "node ./scripts/learn/audit-editorial.mjs",
    "learn:check-bundle-guard": "node ./scripts/learn/check-bundle-guard.mjs",
    "learn:review:export": "node ./scripts/learn/review/export-review.mjs",
    "learn:review:rank": "node ./scripts/learn/review/rank-priority.mjs",
    "learn:review:apply": "node ./scripts/learn/review/apply-edits.mjs",
    "learn:review:status": "node ./scripts/learn/review/progress-report.mjs",
    "learn:check-banned-phrases": "node ./scripts/learn/review/check-banned-phrases.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@supabase/supabase-js": "^2.105.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "playwright-core": "^1.59.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
